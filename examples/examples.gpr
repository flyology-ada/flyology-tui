with "../flyology_tui.gpr";

project Examples is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("counter.adb", "kitchen_sink.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnatwa", "-gnatyM79");
   end Compiler;
end Examples;
