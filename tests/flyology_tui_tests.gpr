with "config/flyology_tui_tests_config.gpr";
project Flyology_Tui_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Flyology_Tui_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("flyology_tui_tests.adb",
      "foundation_layout_tests.adb",
      "controls_tests.adb",
      "visual_components_tests.adb",
      "window_components_tests.adb",
      "accordion_tests.adb",
      "data_navigation_tests.adb",
      "editing_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Tui_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Flyology_Tui_Tests;
