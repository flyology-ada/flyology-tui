with "../flyology_tui.gpr";
project Menubar_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/menubars";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("menubar_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O0", "-gnatwa", "-gnatyM79", "-gnatW8");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Menubar_Tests;
