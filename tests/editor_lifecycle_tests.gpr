with "../flyology_tui.gpr";
project Editor_Lifecycle_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/lifecycle";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("editor_lifecycle_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnatwa", "-gnatyM79");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Editor_Lifecycle_Tests;
